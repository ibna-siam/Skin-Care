# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Database Configuration (PostgreSQL / SQLite for development fallback)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skincare_db?schema=public"

# Authentication Security
JWT_SECRET=super_secret_jwt_key_skincare_bangladesh_2026_dev
JWT_EXPIRES_IN=7d

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Bangladesh Payment Gateways
# bKash API credentials
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=sandbox_app_key
BKASH_APP_SECRET=sandbox_app_secret
BKASH_USERNAME=sandbox_username
BKASH_PASSWORD=sandbox_password

# Nagad API credentials
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0/api/dfs
NAGAD_MERCHANT_ID=sandbox_merchant_id
NAGAD_MERCHANT_PRIVATE_KEY=sandbox_private_key
NAGAD_PG_PUBLIC_KEY=sandbox_public_key

# SSLCommerz credentials
SSLCOMMERZ_STORE_ID=testbox
SSLCOMMERZ_STORE_PASSWORD=qwerty
SSLCOMMERZ_IS_SANDBOX=true

# Email Notification (SMTP / Resend)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=sandbox_user
EMAIL_PASSWORD=sandbox_password
EMAIL_FROM="Skincare Bangladesh <no-reply@skincare.com.bd>"
